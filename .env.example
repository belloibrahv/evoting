# ─────────────────────────────────────────────
#  TASFUED EVS — Environment Configuration
#  Copy to .env and fill in values before running
# ─────────────────────────────────────────────

# Flask
FLASK_ENV=development
SECRET_KEY=change-me-use-a-long-random-string-in-production

# Database
# Dev: leave as sqlite:///evoting.db
# Prod: postgresql+psycopg2://user:pass@host:5432/evoting_db
DATABASE_URL=sqlite:///evoting.db

# Bcrypt work factor (12 for prod, 4 for faster tests)
BCRYPT_LOG_ROUNDS=12

# Session config (seconds)
SESSION_IDLE_TIMEOUT=1800

# Rate limiting (use "memory://" for dev, Redis URL for prod)
RATELIMIT_STORAGE_URL=memory://

# Email (for password-reset tokens)
MAIL_SERVER=smtp.example.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=no-reply@evs.tasfued.edu.ng

# App-level
ADMIN_MATRIC=ADMIN001
APP_NAME=TASFUED EVS
INSTITUTION_NAME=Tai Solarin Federal University of Education
